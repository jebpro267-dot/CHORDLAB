# Browser API origin. Leave unset to use Vite's same-origin dev proxy.
VITE_BACKEND_URL=

# Optional hosted web app URL for Capacitor; unset uses bundled web assets.
CAPACITOR_SERVER_URL=

# Optional AI provider for lyrics romanization (OpenAI-compatible API).
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Initial administrator account. Password is hashed before SQLite storage.
ADMIN_USERNAME=jebin
ADMIN_PASSWORD=

# Optional: defaults to the public ChordMini service.
CHORDMINI_API_URL=https://chordmini.me
# Needed only when using the public service; self-hosted ChordMiniApp usually does not need it.
CHORDMINI_APP_CHECK_TOKEN=

# Demucs must be installed in the server's Python environment.
# Override this when the app runs outside the shell where Demucs is installed.
DEMUCS_PYTHON=.venv/bin/python
DEMUCS_MODEL=htdemucs

# Add production web and Capacitor origins when deploying the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,capacitor://localhost,http://localhost